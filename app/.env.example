# Copia este archivo a app/.env (ignorado por Git). Nunca subas credenciales reales.
# PostgreSQL principal de Nodara (creado con scripts/setup-postgres.ps1).
DATABASE_URL=postgresql://nodara:CAMBIAR_CONTRASENA@127.0.0.1:5432/nodara
# Base desechable para pruebas de integración (el nombre DEBE terminar en _test).
DATABASE_URL_TEST=postgresql://nodara:CAMBIAR_CONTRASENA@127.0.0.1:5432/nodara_test
# Sin DATABASE_URL, Nodara usa PGlite en <repo>/.data/pglite (o NODARA_DATA_DIR).
# NODARA_DATA_DIR=
